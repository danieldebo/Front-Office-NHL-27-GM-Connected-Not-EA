# Front Office — settings for running on your own machine (outside Replit).
# Copy this file to .env.local and fill it in. .env.local is git-ignored;
# never commit it.

# Local Postgres 16. The database has to exist already (createdb frontoffice_dev);
# scripts/dev-local.sh brings its schema up to date on every start.
DATABASE_URL=postgresql://localhost:5432/frontoffice_dev

# Clerk. On Replit these come from the workspace's Auth pane. Outside Replit
# they come from your own Clerk application: use the Development instance's
# keys from the Clerk dashboard (API keys page).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Ports on this machine. The web app is the one you open in a browser.
WEB_PORT=4100
API_PORT=4101
