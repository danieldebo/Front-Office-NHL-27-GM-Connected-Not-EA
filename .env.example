# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/frontoffice

# ── Session ─────────────────────────────────────────────────────────────────
# Long random string — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── OAuth callback base URL ──────────────────────────────────────────────────
# Set to the public root of your deployment (no trailing slash).
# On Replit this is https://<your-slug>.replit.dev  (or your custom domain).
# Used to build  /api/auth/<provider>/callback  URLs registered with each provider.
CALLBACK_BASE_URL=https://your-app.replit.dev

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.developers.google.com/
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Xbox / MS account) ─────────────────────────────────────
# Register app at: https://portal.azure.com/ → App registrations
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/microsoft/callback
# Required API permission: User.Read (Microsoft Graph)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Discord OAuth ────────────────────────────────────────────────────────────
# Create application at: https://discord.com/developers/applications
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/discord/callback
# Required scopes: identify, email
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
