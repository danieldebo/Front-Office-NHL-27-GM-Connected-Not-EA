# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/frontoffice

# ── Session ─────────────────────────────────────────────────────────────────
# Long random string — generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# ── OAuth callback base URL ──────────────────────────────────────────────────
# Set to the public root of your deployment (no trailing slash).
# On Replit this is https://<your-slug>.replit.dev  (or your custom domain).
# Used to build  /api/auth/<provider>/callback  URLs registered with each provider.
CALLBACK_BASE_URL=https://your-app.replit.dev

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.developers.google.com/
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Xbox / MS account) ─────────────────────────────────────
# Register app at: https://portal.azure.com/ → App registrations
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/microsoft/callback
# Required API permission: User.Read (Microsoft Graph)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Xbox Live identity verification ─────────────────────────────────────────
# Secondary "link your Xbox account" flow (Clerk stays the primary login).
# Register a free app at https://portal.azure.com/ → App registrations →
# "Accounts in personal Microsoft accounts only" → Authentication → add a
# Web redirect URI: ${CALLBACK_BASE_URL}/api/xbox/link/callback
# Request the XboxLive.signin scope (not in the permissions picker — pass it
# in the authorize URL; this app already does).
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# Random secret used to HMAC-sign the OAuth `state` param — generate with:
#   openssl rand -base64 32
XBOX_STATE_SECRET=
# 32-byte AES-256 key (base64) used to encrypt the stored Microsoft refresh
# token at rest — generate with: openssl rand -base64 32
XBOX_TOKEN_ENC_KEY=

# ── Discord OAuth ────────────────────────────────────────────────────────────
# Create application at: https://discord.com/developers/applications
# Authorized redirect URI: ${CALLBACK_BASE_URL}/api/auth/discord/callback
# Required scopes: identify, email
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── NHL player registry & stat cards ────────────────────────────────────────
# Free, keyless public NHL API — no credentials needed. Defaults shown are
# sane; only set these to override. See docs/registry-sync-spec.md.
NHL_STATS_API_BASE=https://api.nhle.com/stats/rest/en
NHL_WEB_API_BASE=https://api-web.nhle.com/v1
REGISTRY_SYNC_SEASONS=5          # how many recent seasons to pull the pool from
NHL_API_MAX_RPS=4                # polite ceiling; we are a guest
NHL_API_MAX_RETRIES=4
STATCARD_STALE_DAYS=7

# ── Weekly commissioner digest email ────────────────────────────────────────
# There is no email provider wired up in this sandbox. sendEmail() (see
# server/emailSender.ts) is written against a generic transactional-email
# REST shape (POST {from,to,subject,text} with a Bearer key) so plugging in a
# real provider is a matter of setting these three — nothing to rewrite.
EMAIL_API_BASE=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
