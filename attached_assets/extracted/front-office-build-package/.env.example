# Front Office — environment
# On Replit, set these in the Secrets pane. Never commit real values.

# --- Database ---------------------------------------------------------------
# Provided automatically by Replit PostgreSQL.
DATABASE_URL=postgres://user:password@host:5432/frontoffice

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# --- Auth -------------------------------------------------------------------
# Phase 1 uses Replit Auth through the adapter at server/auth/index.ts.
# Phase 2 swaps in Discord without touching any caller.
SESSION_SECRET=generate-a-long-random-string

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CALLBACK_URL=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN=

# --- Phase 3: charity layer -------------------------------------------------
# CauseFully integration. Front Office records receipts; it never processes
# payments and never holds funds. There is deliberately no processor key here.
# CAUSEFULLY_API_BASE=
# CAUSEFULLY_PUBLIC_KEY=
# CAUSEFULLY_WEBHOOK_SECRET=

# --- Phase 4: ingest --------------------------------------------------------
# INGEST_MAX_BATCH_MB=25
# OCR_CONFIDENCE_THRESHOLD=0.85
